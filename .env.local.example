# Copie ce fichier en .env.local (jamais commité) et colle tes clés.

# Génère-le sur https://www.discogs.com/settings/developers -> "Generate new token"
# Fait passer le quota API de 25 à 60 requêtes/minute.
DISCOGS_TOKEN=

# Crée une app sur https://developer.spotify.com/dashboard (gratuit, instantané)
# -> Client ID et Client Secret dans les settings de l'app. Utilisé uniquement
# côté serveur (api/spotify/search.ts) pour l'embed Spotify avec preview.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
